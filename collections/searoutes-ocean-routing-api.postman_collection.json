      "item": [
        {
          "id": "7a4504ea-2e41-4e08-962c-c4691fc88cde",
          "name": "Get sea route between locations",
          "request": {
            "name": "Get sea route between locations",
            "description": {
              "content": "Returns the sea route between a source and target location (and up to 20 waypoints) as coordinate pairs (longitude,latitude) or UN/LOCODEs separated by semicolons, along with route distance (meters), duration (milliseconds), and the crossed areas.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "route",
                "v2",
                "sea",
                ":locations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "continuousCoordinates",
                  "value": "true"
                },
                {
                  "disabled": false,
                  "key": "allowIceAreas",
                  "value": "false"
                },
                {
                  "disabled": false,
                  "key": "avoidHRA",
                  "value": "false",
                  "description": "Avoid the High Risk Area."
                },
                {
                  "disabled": false,
                  "key": "avoidSeca",
                  "value": "false",
                  "description": "Avoid Sulphur Emission Control Areas."
                },
                {
                  "disabled": false,
                  "key": "blockAreas",
                  "value": "<string>",
                  "description": "Comma-separated area ids to block."
                },
                {
                  "disabled": false,
                  "key": "departure",
                  "value": "<long>",
                  "description": "Departure time as a Unix timestamp in milliseconds."
                },
                {
                  "disabled": false,
                  "key": "imo",
                  "value": "<integer>",
                  "description": "Vessel IMO number."
                },
                {
                  "disabled": false,
                  "key": "speed",
                  "value": "<number>",
                  "description": "Vessel speed in km/h."
                },
                {
                  "disabled": false,
                  "key": "speedInKts",
                  "value": "<number>",
                  "description": "Vessel speed in knots."
                },
                {
                  "disabled": false,
                  "key": "vesselDraft",
                  "value": "<number>",
                  "description": "Vessel draft in meters."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "locations",
                  "description": "(Required) Coordinate pairs (longitude,latitude) or UN/LOCODEs separated by semicolons. Up to 20 positions."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
